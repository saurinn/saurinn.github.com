---
import { GLOBAL } from "../lib/variables";

const year = new Date().getFullYear();
---

<footer class="band border-t border-neutral-200 dark:border-neutral-800">
  <div
    class="shell flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-8 text-sm"
  >
    <nav aria-label="Elsewhere">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li><a class="quiet-link" href={GLOBAL.links.github} rel="me">github</a></li>
        <li><a class="quiet-link" href={GLOBAL.links.x} rel="me">x</a></li>
        <li><a class="quiet-link" href="/about/">about</a></li>
      </ul>
    </nav>
    <p class="meta">
      &copy; {year} {GLOBAL.bio.name}
    </p>
  </div>
</footer>
