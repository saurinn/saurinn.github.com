---
import { GLOBAL } from "../lib/variables";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/index\.html$/, "/");
const isActive = (url: string) =>
  url === "/" ? path === "/" : path === url || path.startsWith(url);
---

<header
  class="band sticky top-0 z-40 border-b border-neutral-200 bg-neutral-50/95 backdrop-blur-sm dark:border-neutral-800 dark:bg-neutral-950/95"
>
  <div
    class="shell flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-4"
  >
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a
        href="/"
        class="text-lg font-semibold tracking-tight hover:underline underline-offset-4">{GLOBAL.bio.handle}</a
      >
      <nav aria-label="Main">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
          {
            Object.entries(GLOBAL.menu).map(([label, url]) => (
              <li>
                <a
                  href={url}
                  aria-current={isActive(url) ? "page" : undefined}
                  class:list={[
                    "underline-offset-4 hover:text-neutral-900 hover:underline dark:hover:text-neutral-50",
                    isActive(url)
                      ? "font-medium text-neutral-900 dark:text-neutral-50"
                      : "text-neutral-500 dark:text-neutral-400",
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <ThemeToggle />
  </div>
</header>
